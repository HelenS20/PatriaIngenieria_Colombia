# Copia este archivo a .env.local. Configura un dominio remitente verificado en Resend.
# No subas .env.local a GitHub ni uses NEXT_PUBLIC_ para estas variables.
RESEND_API_KEY=
EMAIL_FROM=Patria Ingeniería <notificaciones@tu-dominio-verificado.com>
MESSAGES_TO_EMAIL=flomestudio@gmail.com
# Número de WhatsApp confirmado, en formato internacional y solo dígitos.
# Ejemplo de formato para Colombia: 57 seguido de 10 dígitos. Dejar vacío oculta el botón.
NEXT_PUBLIC_WHATSAPP_NUMBER=
